{
  "name": "aivorelay-app",
  "private": true,
  "version": "1.0.55",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "postinstall": "bun scripts/check-nix-deps.ts",
    "test:frontend": "bun test",
    "test:frontend:coverage": "bun test --coverage",
    "tauri": "tauri",
    "test:backend": "pwsh -NoProfile -File ./test-local.ps1",
    "test:backend:lib": "pwsh -NoProfile -File ./test-local.ps1 -LibOnly",
    "test:backend:list": "pwsh -NoProfile -File ./test-local.ps1 -LibOnly -List",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "build:unsigned": "bun run build-unsigned.js",
    "check:translations": "bun scripts/check-translations.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "sync:catalog": "bun scripts/sync-catalog.ts",
    "check:catalog": "bun scripts/sync-catalog.ts --check"
  },
  "dependencies": {
    "@handy-computer/models": "0.2.3",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-autostart": "~2.5.1",
    "@tauri-apps/plugin-clipboard-manager": "~2.3.2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "~2.4.4",
    "@tauri-apps/plugin-global-shortcut": "~2.3.2",
    "@tauri-apps/plugin-opener": "^2.5.2",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tauri-apps/plugin-sql": "~2.3.1",
    "@tauri-apps/plugin-store": "~2.4.1",
    "@tauri-apps/plugin-updater": "~2.10.1",
    "i18next": "^25.10.10",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.6.6",
    "react-select": "^5.10.2",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-i18next": "^6.1.5",
    "prettier": "^3.10.1",
    "typescript": "~5.6.3",
    "vite": "^6.4.6"
  }
}
