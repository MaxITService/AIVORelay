{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "linux",
  "description": "Linux-only: lets the main window read the size of and play its own recordings in History",
  "windows": ["main"],
  "platforms": ["linux"],
  "permissions": [
    "fs:allow-stat",
    {
      "identifier": "fs:scope",
      "allow": [{ "path": "$APPDATA" }, { "path": "$APPDATA/**/*" }]
    }
  ]
}
